# ==========================================
# Gear Station Email & Notification Configuration
# ==========================================

# Target notification recipient for business order alerts
NOTIFICATION_EMAIL=Contact@gearstation.in
FORMSUBMIT_TOKEN=Contact@gearstation.in

# Outbound Mail Server (SMTP) Configuration (Optional - fallback uses FormSubmit directly)
# Example for Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true
# Example for Custom Domain / cPanel: SMTP_HOST=mail.gearstation.in, SMTP_PORT=465, SMTP_SECURE=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Gear Station" <Contact@gearstation.in>
